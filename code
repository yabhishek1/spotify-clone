<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Spotify clone</title>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="icon" href="./assets/logo.png">
    <style>
        /* Base Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #121212;
            color: #ffffff;
        }

        /* Navigation Bar */
        header {
            background-color: rgba(0, 0, 0, 0.85);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 10%;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
        }

        .logo {
            display: flex;
            align-items: center;
            font-size: 24px;
            font-weight: bold;
            color: #fff;
            text-decoration: none;
        }

        .logo i {
            color: #1ED760;
            margin-right: 8px;
            font-size: 28px;
        }

        nav ul {
            display: flex;
            list-style: none;
        }

        nav ul li {
            margin-left: 30px;
        }

        nav ul li a {
            color: #ffffff;
            text-decoration: none;
            font-weight: 700;
            font-size: 16px;
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: #1ED760;
        }

        .nav-separator {
            color: #ffffff;
            margin: 0 10px;
        }

        /* Hero Section */
        .hero {
            background-color: #2941ab;
            min-height: 85vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
            margin-top: 70px;
        }

        .hero h1 {
            font-size: 80px;
            font-weight: 900;
            letter-spacing: -2px;
            margin-bottom: 24px;
            color: #1ED760;
            max-width: 900px;
            line-height: 1.1;
        }

        .hero p {
            font-size: 18px;
            font-weight: 500;
            margin-bottom: 40px;
            max-width: 700px;
            line-height: 1.5;
        }

        .btn-premium {
            background-color: #1ED760;
            color: #121212;
            text-decoration: none;
            padding: 14px 32px;
            border-radius: 50px;
            font-weight: bold;
            font-size: 14px;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: transform 0.2s, background-color 0.2s;
        }

        .btn-premium:hover {
            background-color: #21e065;
            transform: scale(1.04);
        }

        /* Footer Section */
        footer {
            background-color: #000000;
            padding: 80px 10% 40px 10%;
        }

        .footer-links {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 2fr;
            gap: 20px;
        }

        .footer-logo i {
            color: #ffffff;
            font-size: 40px;
        }

        .footer-column h3 {
            color: #919496;
            font-size: 12px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 22px;
        }

        .footer-column ul {
            list-style: none;
        }

        .footer-column ul li {
            margin-bottom: 16px;
        }

        .footer-column ul li a {
            color: #ffffff;
            text-decoration: none;
            font-size: 16px;
            transition: color 0.2s;
        }

        .footer-column ul li a:hover {
            color: #1ED760;
        }

        .social-icons {
            display: flex;
            justify-content: flex-end;
            gap: 15px;
        }

        .social-icons a {
            background-color: #212121;
            color: #ffffff;
            width: 54px;
            height: 54px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 20px;
            text-decoration: none;
            transition: color 0.2s;
        }

        .social-icons a:hover {
            color: #1ED760;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            header {
                padding: 20px 5%;
            }
            nav ul {
                display: none; /* Can be handled via a mobile burger menu in JS */
            }
            .hero h1 {
                font-size: 44px;
            }
            .footer-links {
                grid-template-columns: 1fr;
                text-align: left;
                gap: 40px;
            }
            .social-icons {
                justify-content: flex-start;
            }
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <header>
        <a href="#" class="logo">
            <i class="fa-brands fa-spotify"></i> Spotify
        </a>
        <nav>
            <ul>
                <li><a href="#">Premium</a></li>
                <li><a href="#">Support</a></li>
                <li><a href="#">Download</a></li>
                <li class="nav-separator">|</li>
                <li><a href="#">Sign Up</a></li>
                <li><a href="#">Log In</a></li>
            </ul>
        </nav>
    </header>

    <!-- Main Hero Landing Content -->
    <section class="hero">
        <h1>Listening is everything</h1>
        <p>Millions of songs and podcasts. No credit card needed.</p>
        <a href="#" class="btn-premium">Get Spotify Free</a>
    </section>

    <!-- Footer Area -->
    <footer>
        <div class="footer-links">
            <div class="footer-logo">
                <i class="fa-brands fa-spotify"></i>
            </div>
            <div class="footer-column">
                <h3>Company</h3>
                <ul>
                    <li><a href="#">About</a></li>
                    <li><a href="#">Jobs</a></li>
                    <li><a href="#">For the Record</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h3>Communities</h3>
                <ul>
                    <li><a href="#">For Artists</a></li>
                    <li><a href="#">Developers</a></li>
                    <li><a href="#">Advertising</a></li>
                    <li><a href="#">Investors</a></li>
                    <li><a href="#">Vendors</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h3>Useful Links</h3>
                <ul>
                    <li><a href="#">Support</a></li>
                    <li><a href="#">Web Player</a></li>
                    <li><a href="#">Free Mobile App</a></li>
                </ul>
            </div>
            <div class="social-icons">
                <a href="#"><i class="fa-brands fa-instagram"></i></a>
                <a href="#"><i class="fa-brands fa-twitter"></i></a>
                <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
            </div>
        </div>
    </footer>

</body>
</html>
